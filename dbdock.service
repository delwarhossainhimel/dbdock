[Unit]
Description=dbDock Backup Management Service
After=network.target mysql.service postgresql.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/backup/dbdock
ExecStart=/backup/dbdock/start_dbdock.sh
ExecStop=/bin/kill -15 $MAINPID
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dbdock
PIDFile=/tmp/dbdock.pid

# Security hardening
#PrivateTmp=yes
#NoNewPrivileges=yes
#ProtectSystem=strict
#ReadWritePaths=/backup/dbdock/backup_logs /backup/dbdock/tmp /backup/dbdock/backupdatabase /backup/dbdock/logs /tmp
#ProtectHome=no

[Install]
WantedBy=multi-user.target